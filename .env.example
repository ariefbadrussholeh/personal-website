# Supabase: Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Gunakan "service_role" key (rahasia, hanya di server). JANGAN pakai prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Password untuk masuk ke /admin
ADMIN_PASSWORD=ganti-password-ini
# String acak panjang untuk menandatangani sesi login
SESSION_SECRET=isi-dengan-string-acak-panjang
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opsional: email notifikasi untuk pesan dan komentar baru (resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Opsional: zona waktu untuk grafik analitik (default Asia/Jakarta)
ANALYTICS_TZ=Asia/Jakarta
